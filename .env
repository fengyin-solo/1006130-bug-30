# 唯一环境口径：本地 vite（npm run dev）与容器（docker compose）都读这一份，
# 不要在 frontend/.env.*、Dockerfile 默认值里再写第二遍。个人覆盖放 .env.local。

# 运行环境标识：local / container
APP_ENV=local

# 依赖底座版本：Dockerfile 的基础镜像照这个取，本地要求同主版本（Node 20）
NODE_VERSION=20.20.2-alpine

# 构建/运行参数：vite.config.ts 与容器 EXPOSE 共用
WEB_HOST=0.0.0.0
WEB_PORT=5173

# 进客户端的变量（VITE_ 前缀）
VITE_APP_NAME=盾构隧道掘进施工管理平台
VITE_API_BASE=
