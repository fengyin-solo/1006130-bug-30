# ===========================================================================
# 唯一配置口径：本地开发 / 容器构建 / 流水线都从这一份取值，禁止在别处另写。
# 变量通过 `source .env` 进入 Makefile / docker-compose，VITE_ 开头的由
# frontend/vite.config.ts 用 loadEnv 读取后注入前端。
# ===========================================================================

# ---- 运行环境 ----
APP_ENV=local
NODE_VERSION=20.20.2-alpine

# ---- 依赖版本（钉死，与 frontend/package.json 保持一致）----
PINIA_VERSION=2.1.7
VUE_VERSION=3.4.21
VUE_ROUTER_VERSION=4.3.0
TYPES_NODE_VERSION=20.11.30
PLUGIN_VUE_VERSION=5.0.4
TYPESCRIPT_VERSION=5.4.3
VITE_VERSION=5.2.6
VUE_TSC_VERSION=2.0.7

# ---- 构建参数 ----
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
CONTAINER_HOST=0.0.0.0

# ---- 前端环境变量（Vite 注入，本地与容器同一份）----
VITE_API_BASE=
VITE_APP_NAME=盾构隧道掘进施工管理平台
